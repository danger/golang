{
  "extends": [
    "github>luno/.github:renovate-default-config.json5"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the danger-js version CI installs",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "npm install -g danger@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "danger",
      "datasourceTemplate": "npm"
    }
  ]
}
